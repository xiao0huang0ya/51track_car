 179   1          // 小转弯（一侧内侧传感器偏离黑线）
 180   1          if (LEFT1 == 0 && RIGHT1 == 1 && LEFT2 == 1 && RIGHT2 == 1)   // 左内侧白，其他黑 → 左转
 181   1          {
 182   2              turnleft();
 183   2          }
 184   1          if (LEFT1 == 1 && RIGHT1 == 0 && LEFT2 == 1 && RIGHT2 == 1)   // 右内侧白，其他黑 → 右转
 185   1          {
