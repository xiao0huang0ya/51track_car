 128          // 寻迹控制（1=黑线，0=白线）
 129          void Track(void)
 130          {
 131   1          // 合成当前传感器状态（用于抖动检测）
 132   1          unsigned char cur_state = 0;
 133   1          if (LEFT1) cur_state |= 0x08;   // 左内侧
 134   1          if (LEFT2) cur_state |= 0x04;   // 左外侧
 135   1          if (RIGHT1) cur_state |= 0x02;  // 右内侧
 136   1          if (RIGHT2) cur_state |= 0x01;  // 右外侧
 137   1      
 138   1          // 抖动检测
 139   1          if (cur_state != last_sensor_state)
 140   1          {
 141   2              jitter_count++;
 142   2              if (jitter_count >= JITTER_THRESHOLD)
 143   2              {
 144   3                  straight_hold_time = 10;   // 强制直行0.5秒
 145   3                  jitter_count = 0;
 146   3              }
 147   2          }
 148   1          else
 149   1          {
 150   2              if (jitter_count > 0) jitter_count--;
 151   2          }
 152   1          last_sensor_state = cur_state;
 153   1      
 154   1          // 强制直行优先
 155   1          if (straight_hold_time > 0)
 156   1          {
 157   2              straight();
 158   2              return;
 159   2          }
 160   1      
 161   1          // ---------- 以下所有传感器判断均基于 1=黑线 ----------
 162   1          // 全黑线（四个传感器都检测到黑线）→ 直行
 163   1          if (LEFT1 == 1 && RIGHT1 == 1 && LEFT2 == 1 && RIGHT2 == 1)
 164   1          {
 165   2              straight();
 166   2          }
 167   1      
 168   1          // 十字路口 / 特殊路况（多数传感器为黑线，少量白线）
 169   1          if ((LEFT1 == 1 && RIGHT1 == 0 && LEFT2 == 0 && RIGHT2 == 0)   // 只有左内侧黑，其他白
 170   1           || (LEFT1 == 0 && RIGHT1 == 1 && LEFT2 == 0 && RIGHT2 == 0)   // 只有右内侧黑
 171   1           || (LEFT1 == 0 && RIGHT1 == 0 && LEFT2 == 1 && RIGHT2 == 0)   // 只有左外侧黑
 172   1           || (LEFT1 == 0 && RIGHT1 == 0 && LEFT2 == 0 && RIGHT2 == 1)   // 只有右外侧黑
 173   1           || (LEFT1 == 1 && RIGHT1 == 1 && LEFT2 == 0 && RIGHT2 == 0))  // 两内侧黑，外侧白
 174   1          {
 175   2              straight();
 176   2              Delay(30);
 177   2          }
 178   1      
