 187   2          }
 188   1      
 189   1          // 大转弯（一侧外侧传感器偏离黑线）
 190   1          if (LEFT1 == 1 && RIGHT1 == 1 && LEFT2 == 0 && RIGHT2 == 1)   // 左外侧白，其他黑 → 左大转
 191   1          {
